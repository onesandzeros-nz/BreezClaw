{
  "id": "breezclaw",
  "name": "BreezClaw",
  "description": "Self-custodial Bitcoin and Lightning wallet powered by Breez SDK Spark",
  "version": "1.0.0",
  "entry": "./dist/index.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "breezApiKey": {
        "type": "string",
        "description": "Breez API key (get from https://breez.technology/sdk/)"
      },
      "network": {
        "type": "string",
        "enum": ["mainnet", "testnet"],
        "default": "mainnet",
        "description": "Bitcoin network to use"
      }
    },
    "required": ["breezApiKey"]
  },
  "skills": ["skills/breezclaw"]
}
