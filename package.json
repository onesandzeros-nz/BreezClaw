{
  "name": "@openclaw/breezclaw",
  "version": "1.0.0",
  "description": "Bitcoin and Lightning wallet plugin for OpenClaw using Breez SDK Spark",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@breeztech/breez-sdk-spark": "^0.7.14",
    "@sinclair/typebox": "^0.32.0",
    "bip39": "^3.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "openclaw",
    "bitcoin",
    "lightning",
    "wallet",
    "breez",
    "breezclaw"
  ],
  "openclaw": {
    "extensions": ["./dist/index.js"]
  }
